#!/bin/bash
###############################################################################
# EC2 bootstrap script (cloud-init user data)
#
# Runs once, as root, on first boot.
#
# NOTE: this deploys a simple nginx status page so the ALB has something
# healthy to talk to and so the architecture can be verified end to end.
# In a real deployment this step would instead pull a versioned application
# artifact, or the AMI would be pre-baked with Packer and user data kept
# minimal.
#
# There are NO credentials in this file. Anything the instance needs from
# AWS it gets through the instance profile.
###############################################################################
set -euxo pipefail

exec > >(tee /var/log/user-data.log | logger -t user-data -s 2>/dev/console) 2>&1

echo "=== Bootstrap starting: ${project_name} / ${environment} ==="

dnf update -y
dnf install -y nginx amazon-cloudwatch-agent jq

# ---------------------------------------------------------------------------
# Instance identity, read via IMDSv2.
# The PUT request for a token is what IMDSv2 requires - a plain GET, which
# is all an SSRF vulnerability can produce, will be refused.
# ---------------------------------------------------------------------------
TOKEN=$(curl -sS -X PUT "http://169.254.169.254/latest/api/token" \
  -H "X-aws-ec2-metadata-token-ttl-seconds: 300")

INSTANCE_ID=$(curl -sS -H "X-aws-ec2-metadata-token: $TOKEN" \
  http://169.254.169.254/latest/meta-data/instance-id)
AZ=$(curl -sS -H "X-aws-ec2-metadata-token: $TOKEN" \
  http://169.254.169.254/latest/meta-data/placement/availability-zone)
PRIVATE_IP=$(curl -sS -H "X-aws-ec2-metadata-token: $TOKEN" \
  http://169.254.169.254/latest/meta-data/local-ipv4)

# ---------------------------------------------------------------------------
# Application page. Shows which instance served the request, which makes
# load balancing across AZs visible when you refresh the ALB URL.
# ---------------------------------------------------------------------------
cat > /usr/share/nginx/html/index.html <<HTML
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>${project_name} - ${environment}</title>
  <style>
    body { font-family: system-ui, -apple-system, sans-serif;
           background: #0f172a; color: #e2e8f0; display: flex;
           min-height: 100vh; align-items: center; justify-content: center;
           margin: 0; }
    .card { background: #1e293b; padding: 2.5rem 3rem; border-radius: 12px;
            border: 1px solid #334155; max-width: 640px; }
    h1 { margin: 0 0 .25rem; font-size: 1.5rem; }
    .env { display: inline-block; padding: .2rem .6rem; border-radius: 999px;
           background: #2563eb; font-size: .75rem; text-transform: uppercase;
           letter-spacing: .05em; }
    table { margin-top: 1.5rem; border-collapse: collapse; width: 100%; }
    td { padding: .5rem .75rem; border-bottom: 1px solid #334155;
         font-family: ui-monospace, monospace; font-size: .875rem; }
    td:first-child { color: #94a3b8; width: 40%; }
    footer { margin-top: 1.5rem; font-size: .8rem; color: #64748b; }
  </style>
</head>
<body>
  <div class="card">
    <span class="env">${environment}</span>
    <h1>${project_name}</h1>
    <p style="color:#94a3b8;margin:.25rem 0 0">
      Provisioned with Terraform. Served from a private subnet via an
      Application Load Balancer.
    </p>
    <table>
      <tr><td>Instance ID</td><td>$INSTANCE_ID</td></tr>
      <tr><td>Availability Zone</td><td>$AZ</td></tr>
      <tr><td>Private IP</td><td>$PRIVATE_IP</td></tr>
      <tr><td>Public IP</td><td>none - private subnet</td></tr>
      <tr><td>Region</td><td>${aws_region}</td></tr>
    </table>
    <footer>Refresh to see requests distributed across Availability Zones.</footer>
  </div>
</body>
</html>
HTML

# ---------------------------------------------------------------------------
# Dedicated health endpoint.
#
# Separate from the main page on purpose: the ALB polls this every 30
# seconds, so it must be cheap and must not touch the database. Health
# checks that hit a database turn a slow query into a full outage, because
# the load balancer marks every instance unhealthy at once.
# ---------------------------------------------------------------------------
mkdir -p /usr/share/nginx/html/health
cat > /usr/share/nginx/html/health/index.html <<HTML
{"status":"healthy","instance":"$INSTANCE_ID","az":"$AZ"}
HTML

cat > /etc/nginx/conf.d/app.conf <<NGINX
server {
    listen ${app_port} default_server;
    server_name _;
    root /usr/share/nginx/html;

    access_log /var/log/nginx/access.log;
    error_log  /var/log/nginx/error.log;

    location / {
        try_files \$uri \$uri/ /index.html;
    }

    location /health {
        access_log off;
        default_type application/json;
        try_files /health/index.html =200;
    }

    # Do not advertise the server version to attackers.
    server_tokens off;
}
NGINX

# Remove the default server block so it cannot shadow ours.
rm -f /etc/nginx/conf.d/default.conf || true

nginx -t
systemctl enable --now nginx

# ---------------------------------------------------------------------------
# CloudWatch agent: ship nginx logs and report memory and disk, which EC2
# does not publish natively.
# ---------------------------------------------------------------------------
cat > /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json <<CWA
{
  "agent": { "metrics_collection_interval": 60, "region": "${aws_region}" },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/nginx/access.log",
            "log_group_name": "${log_group}",
            "log_stream_name": "{instance_id}/nginx/access",
            "retention_in_days": 14
          },
          {
            "file_path": "/var/log/nginx/error.log",
            "log_group_name": "${log_group}",
            "log_stream_name": "{instance_id}/nginx/error",
            "retention_in_days": 14
          },
          {
            "file_path": "/var/log/user-data.log",
            "log_group_name": "${log_group}",
            "log_stream_name": "{instance_id}/user-data",
            "retention_in_days": 14
          }
        ]
      }
    }
  },
  "metrics": {
    "namespace": "${project_name}/${environment}",
    "append_dimensions": {
      "InstanceId": "\$${aws:InstanceId}",
      "AutoScalingGroupName": "\$${aws:AutoScalingGroupName}"
    },
    "metrics_collected": {
      "mem":  { "measurement": ["mem_used_percent"], "metrics_collection_interval": 60 },
      "disk": { "measurement": ["used_percent"], "resources": ["/"], "metrics_collection_interval": 60 }
    }
  }
}
CWA

/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
  -a fetch-config -m ec2 \
  -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json \
  -s || echo "WARNING: CloudWatch agent failed to start - continuing"

echo "=== Bootstrap complete on $INSTANCE_ID ==="
